<?xml version="1.0"?>
<!-- amr_visual.urdf — Foxglove 可视化用简化车体模型
     帧名与 amr.sdf / TF 对齐（amr/chassis, amr/chassis/lidar）
     只含视觉几何，不做仿真 -->
<robot name="amr">
  <!-- 根坐标系（无几何，rsp 通过固定 joint 发 amr/odom→amr/chassis） -->
  <link name="amr/odom"/>
  <joint name="base_joint" type="fixed">
    <parent link="amr/odom"/>
    <child link="amr/chassis"/>
  </joint>

  <!-- 底盘 -->
  <link name="amr/chassis">
    <visual>
      <geometry><box size="0.6 0.4 0.2"/></geometry>
      <material name="chassis_blue"><color rgba="0.2 0.35 0.9 1"/></material>
    </visual>
  </link>

  <!-- LiDAR 圆柱（挂点在 chassis 上 0.25 0 0.30，与 amr.sdf 一致） -->
  <link name="amr/chassis/lidar">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="lidar_black"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="amr/chassis"/>
    <child link="amr/chassis/lidar"/>
    <origin xyz="0.25 0 0.30"/>
  </joint>

  <!-- 左轮 -->
  <link name="amr/left_wheel">
    <visual>
      <geometry><cylinder radius="0.075" length="0.04"/></geometry>
      <material name="wheel_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="fixed">
    <parent link="amr/chassis"/>
    <child link="amr/left_wheel"/>
    <origin xyz="0 0.25 -0.05" rpy="1.5708 0 0"/>
  </joint>

  <!-- 右轮 -->
  <link name="amr/right_wheel">
    <visual>
      <geometry><cylinder radius="0.075" length="0.04"/></geometry>
      <material name="wheel_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="fixed">
    <parent link="amr/chassis"/>
    <child link="amr/right_wheel"/>
    <origin xyz="0 -0.25 -0.05" rpy="1.5708 0 0"/>
  </joint>
</robot>
