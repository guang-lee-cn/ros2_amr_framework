{
  // CodeLLDB 调试配置（cpptools 的 cppdbg 已卸载，"type" 一律用 "lldb"）。
  //
  // 前提①（attach 场景）: WSL 默认 ptrace_scope=1 禁止附加非子进程，需先放开（重启失效）:
  //     echo 0 | sudo tee /proc/sys/kernel/yama/ptrace_scope
  //   永久: echo 'kernel.yama.ptrace_scope=0' | sudo tee /etc/sysctl.d/10-ptrace.conf
  // 前提②: 二进制需带调试符号 —— 先跑任务 "colcon build 调试版"（RelWithDebInfo），
  //   默认构建无 -g，断点/变量都看不到。
  "version": "0.2.0",
  "inputs": [
    {
      "id": "pickTest",
      "type": "pickString",
      "description": "选择要调试的测试二进制（build 目录下）",
      "default": "test_astar",
      "options": [
        "test_astar", "test_collision_guard", "test_control_loop", "test_dbscan",
        "test_decision", "test_degradation_policy", "test_depth_obstacle_detector",
        "test_e2e_behavior", "test_fusion", "test_goal_dispatch_gate",
        "test_grid_updater", "test_integration_scenario", "test_kalman_filter",
        "test_lightweight_rpc", "test_monitoring", "test_motor_ctrl",
        "test_observability", "test_ota_agent", "test_ota_coordinator",
        "test_path_smoother", "test_pure_pursuit", "test_qos_profiles",
        "test_results", "test_scan_to_grid", "test_sched_device",
        "test_sensor_hal", "test_sensor_nodes", "test_simulated_scene",
        "test_stamp_gate", "test_supervisor_policy", "test_temperature_hal",
        "test_track_error", "test_tracker", "test_ultrasonic_hal",
        "test_velocity_smoother", "test_vfh_avoidance"
      ]
    },
    {
      "id": "pickNode",
      "type": "pickString",
      "description": "选择要调试的节点可执行文件（install 目录下）",
      "default": "compute_container",
      "options": [
        "amr_supervisor", "bench_cluster", "bench_ping", "bench_pong",
        "camera_node", "compute_container", "factory_markers",
        "fleet_manager_node", "fusion_standalone", "health_monitor_node",
        "imu_node", "lidar_node", "mock_amcl", "ota_agent", "patrol_3c",
        "robot_markers", "scan_filter", "scene_simulator",
        "temperature_monitor_node", "temperature_node", "ultrasonic_node"
      ]
    }
  ],
  "configurations": [
    {
      "name": "附加到运行中的节点",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickProcess}",
      // 典型流程: ./scripts/run_sim.sh 起系统 → F5 选 compute_container 等进程
      "sourceLanguages": ["cpp"]
    },
    {
      "name": "调试域层单测（下拉选择）",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/../../build/ros2_robot_middleware/${input:pickTest}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "colcon build 本包",
      "sourceLanguages": ["cpp"]
    },
    {
      "name": "调试独立节点（下拉选择）",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/../../install/ros2_robot_middleware/lib/ros2_robot_middleware/${input:pickNode}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "colcon build 调试版",
      "env": {
        "LD_LIBRARY_PATH": "/opt/ros/jazzy/lib:/opt/ros/jazzy/opt/rviz_ogre_vendor/lib:${workspaceFolder}/../../install/ros2_robot_middleware/lib"
      },
      "sourceLanguages": ["cpp"]
    }
  ]
}
